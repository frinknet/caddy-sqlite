{
	# The admin API stays enabled so the container HEALTHCHECK can poll
	# /config/. Replace it with `admin off` if you drop the healthcheck.
	admin localhost:2019

	sqlite {
		# Engine-wide: one read pool, one cache, one write-batching policy.
		batch_size    128
		batch_timeout 5ms
		cache_ttl     5s
		cache_max     1000
		timeout       30s

		# Declaring a database attaches it as a schema. Queries address it as
		# app.notes; unqualified names hit the in-memory scratch (main.*).
		db app /var/lib/caddy/app.db {
			migrate  /srv/www/migrations
			optimize 24h
		}

		# The scratch schema: no file, rebuilt from migrations on every start.
		db main {
			migrate /srv/www/scratch-migrations
		}
	}
}

# The REST snippet is imported by name from this Caddyfile's directory.
# Snippets are defined at the top level, outside any site block.
import rest.caddyfile

:80 {
	# The snippet needs the method matchers declared once per site; matcher
	# names are unique per site, so a snippet cannot declare them itself.
	@get    method GET
	@post   method POST
	@put    method PUT
	@patch  method PATCH
	@delete method DELETE

	# Two resources, one line each. This is the entire CRUD surface:
	#   GET    /api/notes      list        POST   /api/notes      create (201)
	#   GET    /api/notes/1    fetch       PUT    /api/notes/1    replace
	#   PATCH  /api/notes/1    update      DELETE /api/notes/1    remove (204)
	import rest notes app.notes body
	import rest tags  app.tags  name

	# Fire-and-forget: this handler answers nothing, the next one owns the
	# response. The row lands in the in-memory scratch, which no write can
	# invalidate and no restart keeps.
	handle /api/audit {
		sqlite {
			query    "INSERT INTO main.audit (path) VALUES (?)"
			bind     1 {http.request.uri.path}
			continue
		}
		respond "queued" 202
	}

	# One hand-written query, for what a snippet does not cover: a cached
	# aggregate that any write anywhere invalidates.
	handle /api/health {
		sqlite {
			query  "SELECT COUNT(*) AS notes FROM app.notes"
			output json
		}
	}

	# Schema files are not public.
	handle /migrations/* {
		respond "Not Found" 404
	}

	handle {
		file_server {
			root /srv/www
		}
	}
}
